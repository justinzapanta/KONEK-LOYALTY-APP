{
  "expo": {
    "name": "KONEK",
    "slug": "konnek-loyalty",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "konnek",
    "userInterfaceStyle": "light",
    "android": {
      "package": "com.konekdigital.loyalty",
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "android.permission.NFC",
        "android.permission.CAMERA"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#081711"
      },
      "allowBackup": false,
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-router",
      "react-native-nfc-manager",
      "expo-font",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow KONEK to scan customer reward QR codes.",
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      "./plugins/with-release-security.cjs",
      [
        "./plugins/with-api-network.cjs",
        {
          "allowCleartext": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "46486020-9af7-4511-8938-0975b5e88255"
      }
    },
    "icon": "./assets/icon.png",
    "web": {
      "name": "KONEK",
      "shortName": "KONEK",
      "favicon": "./public/icon-light-32x32.png"
    }
  }
}
